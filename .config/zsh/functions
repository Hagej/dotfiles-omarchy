# Smart cd with zoxide
if command -v zoxide &> /dev/null; then
  alias cd="zd"
  zd() {
    if (( $# == 0 )); then
      builtin cd ~ || return
    elif [[ -d $1 ]]; then
      builtin cd "$1" || return
    else
      if ! z "$@"; then
        echo "Error: Directory not found"
        return 1
      fi

      printf "\U000F17A9 "
      pwd
    fi
  }
fi

# Open helper
open() (
  xdg-open "$@" >/dev/null 2>&1 &
)

# Custom user functions
function mvf() {
  mv "$@" && cd "${@: -1}"
}

# Omarchy helper functions (tmux layouts, worktrees, etc.)
if [[ -d "$OMARCHY_PATH/default/bash/fns" ]]; then
  for f in "$OMARCHY_PATH"/default/bash/fns/*; do
    source "$f"
  done
fi
